# Dino Screen — a minimal 2D character: an animated GIF (imported Mochi test
# media) playing full-canvas, like an animated display panel. Attach a hardware
# frame-output node (animacore.frame_serial.SerialFrameOutput) to drive a real
# 64x64 LED matrix with it. Asset path is repo-root-relative.
# Preview:  python -m animacore.raster.preview media examples/assets/2d/gifs/DinoRun2.gif --gif dino.gif
# Spec: dev/docs/roadmap/2D_Character_Pipeline.md

anima_version: "2.0"
type: character

identity:
  name: dino_screen
  display_name: Dino Screen
  description: An animated GIF playing on a 2D surface (an animated screen).

canvas2d:
  width: 64
  height: 64
  sources:
    - id: screen
      kind: gif
      asset: examples/assets/2d/gifs/DinoRun2.gif
      loop: true
  surfaces:
    - id: screen
      source: screen
