# Pixel Pet — a layered 2D character built from imported Mochi test media:
# a colorwheel background image with a procedural face composited on top. The
# face reads the same evaluated parameter stream a rig produces (mouth_open,
# mouth_curve, eye_open, fade). Asset paths are repo-root-relative (the engine's
# working directory in a dev build / when running from the repo root).
# Preview:  python -m animacore.raster.preview media examples/assets/2d/images/colorwheel.png --png out.png
# Spec: dev/docs/roadmap/2D_Character_Pipeline.md

anima_version: "2.0"
type: character

identity:
  name: pixel_pet
  display_name: Pixel Pet
  description: A layered 2D character — a colorwheel image with a procedural face.

canvas2d:
  width: 64
  height: 64
  sources:
    - id: bg
      kind: image
      asset: examples/assets/2d/png/colorwheel.png
    - id: face
      kind: procedural
      asset: simple
  surfaces:
    - id: bg
      source: bg
      z: 0
    - id: face
      source: face
      z: 10
      drivers:
        - property: opacity
          source: fade
