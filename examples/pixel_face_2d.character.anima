# Pixel Face — a pure 2D character: a 64x64 procedural LED-matrix face with no
# mechanical rig. The `canvas2d:` block is parsed by animacore/canvas2d_io.py; a
# hybrid 3D + 2D character would carry this block alongside parts/joints. The
# face reads the same evaluated parameter stream a rig produces, so `mouth_open`
# (viseme/amplitude), `mouth_curve`, `eye_open`, `look_x/y`, and `fade` drive it.
# Spec: dev/docs/roadmap/2D_Character_Pipeline.md.

anima_version: "2.0"
type: character

identity:
  name: pixel_face
  display_name: Pixel Face
  description: A 64x64 procedural LED-matrix face driven by evaluated parameters.

canvas2d:
  width: 64
  height: 64
  sources:
    - id: face
      kind: procedural
      asset: simple
  surfaces:
    - id: face
      source: face
      z: 0
      drivers:
        - property: opacity
          source: fade
          input_at_zero: 0.0
          input_at_one: 1.0
          output_at_zero: 0.0
          output_at_one: 1.0
